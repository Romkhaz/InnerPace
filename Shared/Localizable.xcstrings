        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Descent"
          }
        }
      }
    },
    "Спуск быстрее подъёма": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Descent faster than ascent"
          }
        }
      }
    },
    "Средний каденс": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Average cadence"
          }
        }
      }
    },
    "Средний пульс": {

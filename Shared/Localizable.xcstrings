        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light"
          }
        }
      }
    },
    "Сглажив.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smooth."
          }
        }
      }
    },

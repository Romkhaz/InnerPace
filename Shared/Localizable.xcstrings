    "Цель %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target %lld"
          }
        }
      }
    },
    "Цель выше %lld: пульс вряд ли дойдёт до зоны подхода, и регулятор не включится.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target above %lld: heart rate is unlikely to reach the approach zone, and the regulator will not arm."
          }
